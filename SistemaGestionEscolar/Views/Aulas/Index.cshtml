@model IEnumerable<SistemaGestionEscolar.Models.Aula>

@{
    ViewData["Title"] = "Aulas";
}

<h1>Listado de Aulas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nueva Aula</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Numero)</th>
            <th>@Html.DisplayNameFor(model => model.Capacidad)</th>
            <th>@Html.DisplayNameFor(model => model.Edificio)</th>
            <th>@Html.DisplayNameFor(model => model.Piso)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Numero)</td>
            <td>@Html.DisplayFor(modelItem => item.Capacidad)</td>
            <td>@Html.DisplayFor(modelItem => item.Edificio)</td>
            <td>@Html.DisplayFor(modelItem => item.Piso)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>